# Supabase Public Client Configuration (safe for frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Set to 'true' to force local development sandbox mode even if keys exist
VITE_DEV_SANDBOX_MODE=true

# Server-Side Edge Function Secrets (NEVER expose in frontend or commit to git)
# Configure these in Supabase Edge Function secrets:
# GEMINI_API_KEY=your-google-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# EPHEMERAL_MEDIA_BUCKET=ephemeral-media
# MEDIA_TTL_HOURS=48
