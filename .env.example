# ==============================================================================
# PROJECT PHYGITAL — Environment Variables Example
# Copy to .env and fill in real credentials. NEVER commit .env to version control.
# ==============================================================================

# --- Frontend Public Configuration (Safe to expose via Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api

# --- Server-Only Secrets (NEVER prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local API Server & Purge Worker ---
PORT=8787
PURGE_CRON_SECRET=change-me-in-production
PURGE_ALERT_WEBHOOK_URL=
EPHEMERAL_RETENTION_HOURS=48
